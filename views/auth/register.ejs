<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Registration Form</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <div class="main">
      <!-- Sign up Form -->
      <section class="signup">
        <div class="container-1">
          <div class="signup-content">
            <div class="signup-form">
              <h2 class="form-title">Sign up</h2>
              <form
                action="/register"
                method="POST"
                class="register-form"
                id="register-form"
              >
                <div class="form-group">
                  <label for="name" aria-label="Name">
                    <i class="fa-solid fa-user"></i>
                  </label>
                  <input
                    type="text"
                    name="name"
                    id="name"
                    placeholder="Your Name"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="email" aria-label="Email">
                    <i class="fa-solid fa-envelope"></i>
                  </label>
                  <input
                    type="email"
                    name="email"
                    autocomplete="off"
                    id="email"
                    placeholder="Your Email"
                    required
                  />
                </div>

                <!-- Password Input + Strength Meter -->
                <div class="password-field-wrapper">
                  <div class="form-group password-group">
                    <label for="pass" aria-label="Password">
                      <i class="fa-solid fa-lock"></i>
                    </label>
                    <input
                      type="password"
                      name="password"
                      id="pass"
                      placeholder="Password"
                      required
                    />
                    <button
                      type="button"
                      class="password-toggle"
                      data-target="pass"
                      aria-label="Toggle password visibility"
                    >
                      <i class="fa-regular fa-eye"></i>
                    </button>
                  </div>
                </div>

                <% if (errors && errors.length > 0) { %>
                  <% errors.forEach((error) => { %>
                    <p class="flash-error"><%= error %></p>
                  <% }) %>
                <% } %>

                <div>
                  <input
                    type="submit"
                    name="signup"
                    id="signup"
                    class="form-submit"
                    value="Register"
                  />
                </div>
              </form>

              <div class="social-login">
                <div class="social-divider">
                  <span class="social-label">Or sign up with</span>
                </div>
                <ul class="socials">
                  <li>
                    <a href="#" aria-label="Sign up with Facebook">
                      <i class="fa-brands fa-facebook-f"></i>
                    </a>
                  </li>
                  <li>
                    <a href="/github" aria-label="Sign up with GitHub">
                      <i class="fa-brands fa-github"></i>
                    </a>
                  </li>
                  <li>
                    <a href="/google" aria-label="Sign up with Google">
                      <i class="fa-brands fa-google"></i>
                    </a>
                  </li>
                </ul>
              </div>
            </div>

            <div class="signup-image">
              <figure>
                <img src="/images/signup-image.jpg" alt="sign up image" />
              </figure>
              <a href="/login" class="signup-image-link">I am already a member</a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <%- include('../partials/footer.ejs') %>
  </body>
</html>