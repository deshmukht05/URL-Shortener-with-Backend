<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="stylesheet" href="/style.css" />
    <title>URL Shortener</title>
  </head>
  <body>
    <%- include('../views/partials/header.ejs') %>

    <% if (user) { %>
      <h2>You are Logged In</h2>
    <% } else { %>
      <h2>You are not Logged In</h2>
    <% } %>

    <div class="container">
      <h1>URL Shortener</h1>

      <form action="/" method="post">
        <div class="form-label">
          <label for="url">Enter URL</label>
          <div class="input-icon-wrap">
            <i class="fa-solid fa-link"></i>
            <input
              type="url"
              id="url"
              name="url"
              placeholder="https://example.com/your-long-url"
              required
            />
          </div>
        </div>

        <div class="form-label">
          <label for="shortCode">Enter Short Code (Optional)</label>
          <div class="input-icon-wrap">
            <i class="fa-solid fa-code"></i>
            <input
              type="text"
              id="shortCode"
              name="shortCode"
              placeholder="custom-alias"
            />
          </div>
        </div>

        <div class="btn">
          <button type="submit">Shorten</button>
        </div>
      </form>

      <hr />

      <h2>Shortened URLs</h2>
      <ul class="links">
        <% links.forEach(({ shortCode, url }) => { %>
          <li class="link-card">
            <!-- Shortened URL Row -->
            <div class="link-row">
              <div class="link-info">
                <span class="link-badge">Short</span>
                <a href="/<%= shortCode %>" target="_blank" class="short-link">
                  <%= host %>/<%= shortCode %>
                </a>
              </div>
              <button
                type="button"
                class="copy-btn"
                data-url="<%= host %>/<%= shortCode %>"
                title="Copy shortened URL"
                aria-label="Copy shortened URL"
              >
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>

            <!-- Entered / Original URL Row -->
            <div class="link-row original-row">
              <div class="link-info">
                <span class="link-badge original">Original</span>
                <span class="original-link" title="<%= url %>">
                  <%= url %>
                </span>
              </div>
              <button
                type="button"
                class="copy-btn copy-btn-secondary"
                data-url="<%= url %>"
                title="Copy original URL"
                aria-label="Copy original URL"
              >
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>

    <%- include('../views/partials/footer.ejs') %>
  </body>
</html>