<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="./style.css" />
    <title>URL Shortener</title>
  </head>
  <body>
    <%- include('./partials/header.ejs') %>
    <div class="container">
      <h1>URL Shortener</h1>
      <form action="/" method="post">
        <div class="form-label">
          <label for="url">Enter URL</label>
          <input type="url" id="url" name="url" required />
        </div>
        <div class="form-label">
          <label for="shortCode">Enter Short Code (Optional)</label>
          <input type="shortCode" id="shortCode" name="shortCode" />
        </div>
        <div class="btn">
          <button type="submit">Shorten</button>
        </div>
      </form>

      <hr />

      <h2>Short URL</h2>
      <ul class="links">
      <!-- Object.entries(links).map(([shortCode, url]) =>{ 
        url = url.length >= 20 ? `${url.slice(0, 20)}...` : url; return 
          `<li><a href = "/${shortCode}" target = "_blank">${req.host}/${shortCode}</a> - ${url}</li>`},)
        .join("") -->

        <% links.map(({shortCode, url}) =>{ %>
          <li>
            <a href="<%= shortCode%>" target="_blank">
              <%= host%>/<%= shortCode%>
            </a> --> <%= url.length >= 20 ? `${url.slice(0, 20)}...` : url %>
          </li>
          <% }) %>
      </ul>
    </div>
  </body>
</html>
