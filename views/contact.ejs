<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us — URLShortener</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('../views/partials/header.ejs') %>

    <main class="page-wrapper">
      <!-- Hero Section -->
      <section class="page-hero">
        <span class="hero-eyebrow">
          <i class="fa-regular fa-paper-plane"></i>
          Get in Touch
        </span>
        <h1 class="page-title">
          We'd love to <span class="text-gradient">hear from you</span>
        </h1>
        <p class="page-subtitle">
          Have a question about custom links, found a bug, or want to suggest a feature?
          Send us a message and our team will get back to you within 24 hours.
        </p>
      </section>

      <!-- Main Contact Grid -->
      <section class="contact-grid">
        <!-- Left Column: Info Cards + FAQ -->
        <div class="contact-sidebar">
          <div class="contact-info-list">
            <div class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div class="info-text">
                <h3>Email Support</h3>
                <p>For general queries &amp; technical help</p>
                <a href="mailto:support@urlshortener.dev">support@urlshortener.dev</a>
              </div>
            </div>

            <div class="info-card">
              <div class="info-icon secondary">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div class="info-text">
                <h3>Office Location</h3>
                <p>42 Tech Park Avenue, Sector 5<br />Bengaluru, KA 560001</p>
              </div>
            </div>

            <div class="info-card">
              <div class="info-icon">
                <i class="fa-solid fa-clock"></i>
              </div>
              <div class="info-text">
                <h3>Response Hours</h3>
                <p>Mon – Fri: 9:00 AM – 6:00 PM IST</p>
                <span class="response-pill">
                  <span class="pulse-dot"></span>
                  Typical reply: under 4 hours
                </span>
              </div>
            </div>
          </div>

          <!-- Pure HTML/CSS Quick FAQ -->
          <div class="faq-box">
            <h3 class="faq-title">Quick Answers</h3>

            <details class="faq-item" open>
              <summary>
                <span>Is URLShortener free to use?</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                Yes! Creating an account, shortening URLs, and setting custom short codes
                are completely free.
              </p>
            </details>

            <details class="faq-item">
              <summary>
                <span>Do my shortened links expire?</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                No, links created under your account remain active indefinitely unless
                you choose to delete them.
              </p>
            </details>

            <details class="faq-item">
              <summary>
                <span>How do I report an abusive link?</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <p>
                Select "Report a Link" in the form subject and include the short code so
                our team can review it immediately.
              </p>
            </details>
          </div>
        </div>

        <!-- Right Column: Contact Form -->
        <div class="contact-form-card">
          <div class="contact-form-header">
            <h2>Send us a message</h2>
            <p>Fill out the form below and we'll reply to your inbox.</p>
          </div>

          <% if (error) { %>
            <p class="flash-error"><%= error %></p>
          <% } %>

          <% if (success) { %>
            <p class="flash-success"><%= success %></p>
          <% } %>

          <form action="/contact" method="POST" class="contact-form">
            <div class="form-row-2">
              <div class="form-label">
                <label for="contact-name">Full Name</label>
                <div class="input-icon-wrap">
                  <i class="fa-solid fa-user"></i>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    placeholder="John Doe"
                    required
                  />
                </div>
              </div>

              <div class="form-label">
                <label for="contact-email">Email Address</label>
                <div class="input-icon-wrap">
                  <i class="fa-solid fa-envelope"></i>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    placeholder="john@example.com"
                    required
                  />
                </div>
              </div>
            </div>

            <div class="form-label">
              <label for="contact-subject">Topic</label>
              <div class="input-icon-wrap select-wrap">
                <i class="fa-solid fa-tag"></i>
                <select id="contact-subject" name="subject" required>
                  <option value="" disabled selected>Select a topic...</option>
                  <option value="general">General Inquiry</option>
                  <option value="support">Technical Support</option>
                  <option value="feature">Feature Request</option>
                  <option value="report">Report an Abusive Link</option>
                  <option value="partnership">Partnership / Business</option>
                </select>
                <i class="fa-solid fa-chevron-down select-chevron"></i>
              </div>
            </div>

            <div class="form-label">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder="Tell us how we can help..."
                required
              ></textarea>
            </div>

            <button type="submit" class="contact-submit-btn">
              <span>Send Message</span>
              <i class="fa-solid fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </section>
    </main>

    <%- include('../views/partials/footer.ejs') %>
  </body>
</html>